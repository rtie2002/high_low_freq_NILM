  "feature_columns": [
    "aggregate"
  ],
  "appliances": {
    "kettle": {
      "power": "kettle_power",
      "on": "kettle_on"
    },
    "fridge": {
      "power": "fridge_power",
      "on": "fridge_on"
    },
    "microwave": {
      "power": "microwave_power",
      "on": "microwave_on"
    },
    "dishwasher": {
      "power": "dishwasher_power",
      "on": "dishwasher_on"
    },
    "washingmachine": {
      "power": "washingmachine_power",
      "on": "washingmachine_on"
    }
  },
  "sampling_seconds": 6
