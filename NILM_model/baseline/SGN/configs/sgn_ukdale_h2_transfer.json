{
  "preset": "sgn_paper",
  "default_appliance": "all",
  "input_length": 432,
  "output_length": 32,
  "batch_size": 16,
  "learning_rate": 0.0003,
  "lr_schedule": "cosine",
  "lr_warmup_epochs": 5,
  "lr_min": 1.0e-6,
  "epochs": 200,
  "patience": 40,
  "min_epochs": 25,
