  "standby_power": false,
  "weight_decay": 0.0,
  "grad_clip_norm": 1.0,
  "early_stop_metric": "total_loss",
  "label_smoothing": 0.0,
  "bce_pos_weight": 15.0,
  "oversample_on": true,
  "oversample_max_weight": 15.0,
  "reg_on_weight": 1.0,
  "gated_on_weight": 1.0,
  "plot_mode": "end",
  "seed": 1234
