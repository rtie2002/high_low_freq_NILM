{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Full Pipeline (remote GPU)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "▶ Run Pipeline — Smoke Test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1",
        "-Smoke"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}

