{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Run Full Pipeline (remote GPU)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "▶ Run Smoke Test (fast check)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1",
        "-Smoke"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": true
      },
      "problemMatcher": []
    }
  ]
}

