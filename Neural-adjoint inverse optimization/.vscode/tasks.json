{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Run Pipeline (Custom Name prompt)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1",
        "-Name", "${input:experimentName}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "▶ Run Full Pipeline (auto-timestamp)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "▶ Run Smoke Test (fast check)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_pipeline.ps1",
        "-Smoke"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "experimentName",
      "type": "promptString",
      "description": "Enter custom experiment name (e.g. baseline, e1_shared_cnn):",
      "default": "baseline_run"
    }
  ]
}
