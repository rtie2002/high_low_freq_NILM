# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IDEs
.vscode/
.idea/

# ==========================================
# NILM PROJECT SPECIFIC IGNORES
# ==========================================

# 1. Ignore ALL large data file types globally
*.dat
*.flac
*.csv
*.h5
*.npy
*.npz
*.rar
*.zip
*.7z

# 2. Ignore specific data-heavy directories but allow the folder structure
# (We don't use **/Folder/ because it ignores everything inside INCLUDING scripts)

# 3. Specific processed outputs
dataset_preprocess/created_data/

# 4. White-list: ALWAYS keep these files even if they are in data folders
!**/*.py
!**/*.md
!**/*.yaml
!**/*.txt
!**/README.md
!**/.gitignore

# UNet-NILM bundled reproduction assets (see baseline/UNETNILM/REPRODUCTION.md)
!NILM_model/baseline/UNETNILM/data.zip
!NILM_model/baseline/UNETNILM/results.zip
!NILM_model/baseline/UNETNILM/*.md
!NILM_model/baseline/UNETNILM/requirements.txt
!NILM_model/baseline/UNETNILM/run_reproduce.py

# Logs
*.log
*.cfg

# Local secrets (training device passwords, etc.)
**/training_device.secrets.md
**/*.secrets.md

# Agent / Cursor local state
.cursor/

# MATUDA / multi_appliances run artifacts (regenerable)
MATUDA_NILM/results/
MATUDA_NILM/paper/figures/
multi_appliances_NILM/runs/
**/_auto_loop/
**/_journal_p0_logs/
**/_matuda_queue_logs/

# LaTeX build products (keep main.tex / IEEEtran.cls)
MATUDA_NILM/paper/*.aux
MATUDA_NILM/paper/*.log
MATUDA_NILM/paper/*.fls
MATUDA_NILM/paper/*.fdb_latexmk
MATUDA_NILM/paper/*.synctex.gz
MATUDA_NILM/paper/*.out
MATUDA_NILM/paper/main.pdf

# Agent / scratch dumps (never commit)
**/_lit_extract/
**/_remote*
**/_tmp*
**/_plink*
**/docs/_tmp_*
**/docs/_lin_pdf_extract.txt
*.tmp.ps1
matuda_visible_*.ps1
matuda_test_*.ps1

# 5. Literature and papers
/frequency domain/

/feature_selection_outputs
/.history
/dataset_preprocess
!/dataset_preprocess/
!/dataset_preprocess/UK_DALE_16khz/
!/dataset_preprocess/UK_DALE_16khz/calibration_house_*.cfg
/feature_selection_outputs(on only)
/feature_selection/results
*.png
*.pdf
*.png
!feature_selection/
!feature_selection/dataset/

